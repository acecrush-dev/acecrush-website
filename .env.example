# AceCrush Craft 官网部署环境变量
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，不会入库
#
# Vercel 部署不需要这里配：vercel login 已经 OIDC 认证，CLI 自动用 .vercel/project.json。
# 项目 ID 已经在 .vercel/project.json 里（vercel link 时生成），无需重复。

# === Cloudflare（DNS 自动配置用） ===
# Cloudflare Dashboard → 头像 → My Profile → API Tokens → Create Token
# 模板：Edit zone DNS
# Zone Resources：Specific zone → acecrush.dev
# 权限：Zone / DNS / Edit（默认包含 Read）
CF_API_KEY=
CF_EMAIL=
CF_ZONE=acecrush.dev

# === Vercel（仅 CI 用；本地 CLI 部署无需） ===
# 本地用 `vercel login` 浏览器授权 + `vercel link` 即可
# CI 自动化部署才需要 VERCEL_TOKEN：
#   Vercel Dashboard → Settings → Tokens → Create
#   Scope: Full Account 或指定项目
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# === Next.js dev server 跨源白名单（v61）===
# 默认放行 localhost / 127.0.0.1 / 0.0.0.0
# 局域网 / 移动设备用 IP 访问时把 IP 加进来（多个用英文逗号分隔）
# 例：NEXT_PUBLIC_DEV_ORIGINS=192.168.7.212,192.168.7.213
# 不影响生产构建（output:'export' 静态导出，不读 dev server 配置）
# NEXT_PUBLIC_DEV_ORIGINS=
